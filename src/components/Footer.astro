---
import type { Locale } from '../i18n/locales';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-gray-100 mt-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
      <div>
        <p class="font-semibold text-gray-900 mb-1">{t('Still need help?', locale)}</p>
        <a href="mailto:support@ownia.co" class="text-sm text-sky-600 hover:text-sky-700 font-medium">
          {t('Contact support', locale)} →
        </a>
      </div>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-gray-500">
        <a href={`/${locale}/`} class="hover:text-gray-700 transition-colors">{t('All articles', locale)}</a>
        <a href="https://ownia.co" class="hover:text-gray-700 transition-colors">{t('Explore Ownia', locale)}</a>
        <a href="https://ownia.co/pricing" class="hover:text-gray-700 transition-colors">{t('Pricing', locale)}</a>
        <a href="https://ownia.co/terms" class="hover:text-gray-700 transition-colors">Terms</a>
        <a href="https://ownia.co/privacy" class="hover:text-gray-700 transition-colors">Privacy</a>
      </div>
    </div>
    <p class="text-xs text-gray-400 mt-8">© {year} Ownia</p>
  </div>
</footer>
