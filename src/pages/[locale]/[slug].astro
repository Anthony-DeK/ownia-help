---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import type { Locale } from '../../i18n/locales';
import { slugFor, getTranslationLocales, type HelpArticle } from '../../lib/articles';

export async function getStaticPaths() {
  const all = await getCollection('help');
  return all.map((entry) => ({
    params: { locale: entry.data.locale, slug: slugFor(entry) },
    props: { entry },
  }));
}

interface Props {
  entry: HelpArticle;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const locale = entry.data.locale as Locale;
const translationSlugs = await getTranslationLocales(entry.data.articleId);
---

<ArticleLayout
  locale={locale}
  slug={slugFor(entry)}
  title={entry.data.title}
  description={entry.data.description}
  category={entry.data.category}
  updatedDate={entry.data.updatedDate}
  translationSlugs={translationSlugs}
>
  <Content />
</ArticleLayout>
