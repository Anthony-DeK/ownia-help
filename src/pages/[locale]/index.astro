---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCALES, type Locale } from '../../i18n/locales';
import { CATEGORIES, CATEGORY_LABELS } from '../../i18n/categories';
import { t } from '../../i18n/ui';
import { getArticlesForLocale, slugFor } from '../../lib/articles';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const articles = await getArticlesForLocale(locale);
const byCategory = CATEGORIES.map((category) => ({
  category,
  label: CATEGORY_LABELS[category][locale],
  articles: articles.filter((a) => a.data.category === category),
})).filter((group) => group.articles.length > 0);
---

<BaseLayout locale={locale} title={`${t('Help Center', locale)} | Ownia`} description="Guides and answers for running your short-term rental business on Ownia." path="">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-3">{t('Help Center', locale)}</h1>
    <p class="text-gray-500 mb-12 max-w-2xl">
      Guides and answers for running your short-term rental business on Ownia.
    </p>

    <div class="grid sm:grid-cols-2 gap-x-10 gap-y-12">
      {byCategory.map((group) => (
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wide text-sky-600 mb-4">{group.label}</h2>
          <ul class="space-y-3">
            {group.articles.map((article) => (
              <li>
                <a href={`/${locale}/${slugFor(article)}/`} class="text-gray-800 hover:text-sky-600 font-medium transition-colors">
                  {article.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
